{
  "expo": {
    "name": "student-teacher-consultation",
    "slug": "student-teacher-consultation",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "studentteacherconsultation",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "newArchEnabled": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires camera access for video consultations.",
        "NSMicrophoneUsageDescription": "This app requires microphone access for video consultations."
      }
    },
    "android": {
      "package": "com.psau.iconsult",
      "newArchEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "icon": "./assets/images/icon.png",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": ["https://www.jitpack.io"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "assetBundlePatterns": ["**/*"],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a7bbb4e-7f04-4bc5-96c2-86b599263efd"
      }
    }
  }
}
